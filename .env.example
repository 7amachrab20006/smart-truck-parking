# ==============================================
# Smart Truck & Parking Assistant — Environment
# ==============================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to source control.

# ---- Application ----
APP_NAME=SmartTruckParkingAssistant
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ---- Backend Server ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---- Database (PostgreSQL + PostGIS) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smart_truck_db
POSTGRES_USER=smart_truck_user
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---- JWT Authentication ----
JWT_SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_STRING_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- External Services ----
# Mapbox (required for map tiles and routing — get key at mapbox.com)
MAPBOX_ACCESS_TOKEN=

# Firebase Cloud Messaging (required for push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=

# ---- NYC Open Data (SODA API — no key required, but app token improves rate limits) ----
NYC_OPEN_DATA_APP_TOKEN=
NYC_OPEN_DATA_BASE_URL=https://data.cityofnewyork.us

# ---- Rate Limiting ----
RATE_LIMIT_PER_MINUTE=60

# ---- File Uploads ----
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads
