# Application Configuration
APP_NAME="Smart Truck & Parking Assistant API"
APP_VERSION="1.0.0"
DEBUG=True
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000"]

# Database Connection URLs
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/smart_truck_db"
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_truck_db"

# JWT Authentication
SECRET_KEY="super-secret-key-change-in-production-smart-truck-assistant-2025-token-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# External APIs
NYC_OPEN_DATA_APP_TOKEN="your_socrata_app_token"
NYC_OPEN_DATA_SECRET_TOKEN="your_socrata_secret_token"
MAPBOX_ACCESS_TOKEN="pk.your_mapbox_token"
